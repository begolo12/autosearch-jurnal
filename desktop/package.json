{
  "name": "pustakacari-desktop",
  "version": "1.0.0",
  "description": "PustakaCari — Pencarian Jurnal Q1 & Terjemahan AI Desktop App",
  "main": "main.js",
  "homepage": "https://autosearch-jurnal.vercel.app",
  "author": {
    "name": "PustakaCari",
    "email": "pustakacari@autosearch.app"
  },
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux"
  },
  "devDependencies": {
    "electron": "^35.1.5",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "app.pustakacari.desktop",
    "productName": "PustakaCari",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "package.json",
      "icon.png"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "icon.png"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.education",
      "icon": "icon.png"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Education",
      "maintainer": "PustakaCari <pustakacari@autosearch.app>",
      "icon": "icon.png"
    }
  }
}
